# Copy to .env for local dev. In Railway, set these as service env vars instead.

DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=upwork_assistant.settings.dev

# Postgres (Railway addon provides this automatically as DATABASE_URL)
DATABASE_URL=postgres://user:password@localhost:5432/upwork_assistant

# Production only (upwork_assistant.settings.production)
DJANGO_ALLOWED_HOSTS=yourapp.up.railway.app
RAILWAY_PUBLIC_DOMAIN=
DJANGO_SECURE_SSL_REDIRECT=True

# Gmail API (Google Cloud OAuth client, read-only Gmail scope)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Gmail label applied to Upwork saved-search alert emails (set up a Gmail
# filter that auto-labels them, then point this at that label name)
GMAIL_ALERT_LABEL=Upwork/Alerts

# Local dev only: Google's OAuth library refuses plain http:// by default.
# Uncomment this to test the Gmail connect flow on http://127.0.0.1:8000 —
# never set this in production, where the app runs over real https://.
# OAUTHLIB_INSECURE_TRANSPORT=1

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Chrome extension <-> Django API auth (generate any long random string)
EXTENSION_API_TOKEN=

# Screenshot storage — S3-compatible bucket (e.g. Cloudflare R2). Only
# required in production; local dev falls back to Django's default
# filesystem storage under MEDIA_ROOT.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
