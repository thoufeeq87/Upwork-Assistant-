{
  "manifest_version": 3,
  "name": "Upwork Assistant Capture",
  "version": "1.0.0",
  "description": "Captures a screenshot of the current Upwork job page and sends it to your Upwork Assistant dashboard.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://YOUR-APP.up.railway.app/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Capture Upwork job screenshot"
  },
  "options_page": "options/options.html",
  "icons": {
    "128": "icons/icon128.png"
  }
}
